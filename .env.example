# Create .env with `install -m 600 .env.example .env` (readable only by you) and fill it in.
# Never commit .env.
# Key from a Google AI Studio project WITHOUT billing (AI Studio → Rate Limit shows "Free tier").
GEMINI_API_KEY=
# Generate with: python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
PROXY_TOKEN=

# Without Docker only (docker-compose.yml sets its own host and port inside the container):
PROXY_HOST=127.0.0.1
PROXY_PORT=4000

# Extra host names the proxy answers to, comma-separated, e.g. your Tailscale name
# (README: "Other devices over Tailscale"). Empty = this machine only.
PROXY_ALLOWED_HOSTS=

# Only for `docker compose --profile monitoring up -d`: Grafana's admin password.
GRAFANA_ADMIN_PASSWORD=
